#!/usr/bin/env python3
"""Promote a reviewed DRAFT-*.md topic to a real, queueable topic.

Usage:
    tools/approve-topic <topic-id> [--dest topics/]

Recomputes contract/authority hashes from whatever you actually left in
DRAFT-TOPIC.md / DRAFT-AUTHORITY.md after review (edits are expected and normal),
renames the DRAFT files to their real names, writes the final SEMANTIC-STATE.json,
runs a structural check, and prints a manifest snippet ready for `research-loops add`.

This is the one moment a topic's scope is allowed to become binding. Nothing before
this point is queueable; nothing after this point may be changed by a research agent.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("topic_id")
    parser.add_argument("--dest", default=str(REPO_ROOT / "topics"))
    args = parser.parse_args(argv)

    topic_dir = Path(args.dest) / args.topic_id
    draft_authority = topic_dir / "DRAFT-AUTHORITY.md"
    draft_topic = topic_dir / "DRAFT-TOPIC.md"
    draft_state = topic_dir / "DRAFT-SEMANTIC-STATE.json"
    for path in (draft_authority, draft_topic, draft_state):
        if not path.is_file():
            print(f"error: {path} not found -- run tools/new-topic first", file=sys.stderr)
            return 2

    if (topic_dir / "TOPIC.md").exists():
        print(f"error: {topic_dir}/TOPIC.md already exists -- already approved", file=sys.stderr)
        return 2

    state = json.loads(draft_state.read_text(encoding="utf-8"))
    # Recompute from whatever is actually on disk now, not what new-topic computed
    # at scaffold time -- the whole point of the DRAFT stage is that you edit these.
    state["contract_sha256"] = hashlib.sha256(draft_topic.read_bytes()).hexdigest()
    state["authority_sha256"] = hashlib.sha256(draft_authority.read_bytes()).hexdigest()

    draft_authority.rename(topic_dir / "AUTHORITY.md")
    draft_topic.rename(topic_dir / "TOPIC.md")
    (topic_dir / "SEMANTIC-STATE.json").write_text(
        json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    draft_state.unlink()

    check = subprocess.run(
        [sys.executable, str(REPO_ROOT / "chassis" / "semantic-state.py"), "check", str(topic_dir)],
        capture_output=True,
        text=True,
    )
    print(check.stdout.strip())
    if check.returncode != 0:
        print(check.stderr.strip(), file=sys.stderr)
        return check.returncode

    lock = subprocess.run(
        [sys.executable, str(REPO_ROOT / "chassis" / "semantic-state.py"), "lock", str(topic_dir)],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()

    run_topic = REPO_ROOT / "chassis" / "run-topic.sh"
    print()
    print("Approved. Add it to the queue with:")
    print(
        "  bin/research-loops add --id "
        f"{args.topic_id} --title \"...\" --cwd {topic_dir} "
        f"--stop-file STOP --max-attempts 8 --repeat-seconds 900 -- "
        f"{run_topic} {topic_dir} generic"
    )
    print(f"(completion inventory lock, if you want to pin it: {lock})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
