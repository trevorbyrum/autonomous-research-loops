# Runtime state — never commit a live queue's state or logs
/state/
/logs/
/STATUS.md

# Local deployment config (docs/operations.md says: copy the example here and edit)
/research-loops.toml

# User-created topics under the default ./topics/ path (examples/ is committed on purpose)
/topics/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# OS/editor noise
.DS_Store
*.swp

# Operator-side wiring and credentials (e.g. the GraphRAG ingest hook's
# endpoints file) — must never enter the public repo, tracked or not
*.env
graphrag.env
