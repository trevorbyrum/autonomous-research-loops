# deploy/gen2.env.example — GENERATED by tools/gen_source_catalog.py. Do not edit by hand.
#
# Copy to deploy/gen2.env (gitignored), fill in real values, mount it read-only and 0400 into the
# gen-2 containers that need it. Example values only — nothing here is a real credential.
#
# The research source keys at the end are derived from gateway/research_gateway/registry/seed/sources.toml,
# which is the one source of truth. `make gen2-catalog` regenerates this file and
# docs/gen2/SOURCE-CATALOG.md; `make gen2-check` fails if either drifts from the registry, or if this
# file was edited by hand.
#
# This is the GEN-2 stack's environment. It is never pointed at the running gen-1 gateway service
# or its database (docs/gen2/DEPLOYMENT-CONTRACT.md, "Hard boundary against gen-1").
#
# Trace: task 0c deliverable 2; DEPLOYMENT-CONTRACT.md §3; INVARIANTS H-2 (a failed secrets read is
# a dated capability fact, never "no key configured").

# ================================================================================================
# Gen-2 engine — router, station supervisor, operator transports
# ================================================================================================
# The control store is mounted into THIS container only: the router is the sole writer, so no
# second process opens the SQLite file (DEPLOYMENT-CONTRACT.md §1).
# the one authoritative store
GEN2_CONTROL_STORE=/var/lib/gen2/control.sqlite3
# protected spool for content-addressed artifacts
GEN2_SPOOL_DIR=/var/lib/gen2/spool
# mounted read-only: stations.yaml, fleet policy, prompts, question registry, thresholds
GEN2_CONFIG_BUNDLE_DIR=/etc/gen2/bundle
# operator-owned, operator-trusted, read-only; agents never write here (§4)
GEN2_WRAPPERS_DIR=/etc/gen2/wrappers
# operator service (HTTP + POST /mcp): all of the CONTAINER's interfaces, so the projector and
#   the healthcheck reach it; published on the host at 127.0.0.1:8770 only
#   (DEPLOYMENT-CONTRACT.md §1.1)
GEN2_OPERATOR_LISTEN=0.0.0.0:8770
# one bearer token per operator client; the service refuses to start without any
GEN2_OPERATOR_TOKENS=operator=example-operator-token,mcp=example-mcp-token
# env only for now: vault waits for DEPLOYMENT-CONTRACT.md §3.4
GEN2_SECRETS=env

# ================================================================================================
# Gen-2 engine secrets, vault backend
# ================================================================================================
# NOT ADMISSIBLE YET: the gen-2 vault backend does not exist, and must pass DEPLOYMENT-CONTRACT.md
# §3.4 before anything selects it. Once it has: GEN2_SECRETS=vault selects it, GEN2_VAULT_TOKEN_FILE
# is REQUIRED explicitly, there is no home-directory fallback, and the engine refuses to start
# without it (§3.3 rule 1).
# GEN2_VAULT_ADDR=https://vault.example.org:8200
# mounted read-only, 0400
# GEN2_VAULT_TOKEN_FILE=/run/secrets/gen2-vault-token
# GEN2_VAULT_MOUNT=secret
# GEN2_VAULT_PREFIX=services
# logical=vault-name, when paths differ
# GEN2_VAULT_ALIASES=jev=typesafe-jev

# ================================================================================================
# Decision layer — Jev primary, LLM fallback
# ================================================================================================
# Optional by charter: the engine must run and be testable with the decision layer disabled, so
# the shipped default is off. Initial rollout is screening in shadow and method-selection
# advisory; nothing else (flow §5).
# true only once a question registry and thresholds are mounted
GEN2_DECISION_ENABLED=false
# GEN2_DECISION_JEV_ENDPOINT=https://api.typesafe.ai
# GEN2_SECRET_JEV=example-jev-api-key
# GEN2_DECISION_FALLBACK_ENDPOINT=https://api.example-llm.invalid
# GEN2_SECRET_DECISION_FALLBACK=example-fallback-api-key

# ================================================================================================
# Tier-0 checker — local NLI claim-vs-span screen
# ================================================================================================
# Optional. Absent, the engine records a dated capability fact and verification proceeds without
# the screen; the screen never gated a load-bearing claim (BOUNDARIES.md Tier-0 checker).
GEN2_TIER0_ENABLED=true
GEN2_TIER0_URL=http://tier0:8773

# ================================================================================================
# Gateway client — the engine's only door to external research sources
# ================================================================================================
# The engine reaches the gateway over HTTP and never imports it (INVARIANTS B-2). The token is one
# of the gateway's own client tokens, issued to the engine.
GEN2_GATEWAY_URL=http://gateway:8765
GEN2_SECRET_GATEWAY_TOKEN=example-token-issued-to-the-gen2-engine

# ================================================================================================
# Projector — publication sinks, named physically
# ================================================================================================
# Neo4j and Qdrant are referenced external services: this stack connects to them, and reports a
# dated capability fact when it cannot. A failed sink leaves publication partial; it never rewrites
# completion (INVARIANTS P-2, P-4).
# inside the container; not published to the host
GEN2_PROJECTOR_HEALTH_LISTEN=0.0.0.0:8772
# the engine over the Compose network: the projector's ControlBackend calls (outbox claims,
#   delivery acks)
GEN2_ENGINE_URL=http://engine:8770
# presented by the projector, verified by the engine; projector capability only, never operator
#   authority
GEN2_SECRET_PROJECTOR_TOKEN=example-projector-token
GEN2_NEO4J_URI=bolt://neo4j-host:7687
GEN2_NEO4J_USER=neo4j
GEN2_SECRET_NEO4J_PASSWORD=example-neo4j-password
GEN2_QDRANT_URL=http://qdrant-host:6333
GEN2_SECRET_QDRANT_API_KEY=example-qdrant-api-key

# ================================================================================================
# Export sinks — operator-pluggable research export
# ================================================================================================
# Which sinks are enabled, their destinations, and the per-topic export options are MOUNTED CONFIG.
# Only the credential-bearing part lives here (docs/gen2/EXPORT-SINKS.md §4): one variable per
# enabled sink id, GEN2_SECRET_EXPORT_SINK_<SINK_ID>, upper-cased with - replaced by _. A sink whose
# destination carries no credential (a mounted file path) has no variable here at all.
# mounted read-only
GEN2_EXPORT_SINKS_CONFIG=/etc/gen2/bundle/export-sinks.toml
# generic_sql sink `warehouse`: the DSN embeds the credential, so the whole DSN is the secret
# GEN2_SECRET_EXPORT_SINK_WAREHOUSE=postgresql://exporter:example-password@warehouse-host:5432/research
# webhook_http sink `hook`: the endpoint URL is mounted config; only the token is here
# GEN2_SECRET_EXPORT_SINK_HOOK=example-webhook-bearer-token

# ================================================================================================
# Gen-2 research gateway instance
# ================================================================================================
# The gateway runs its own image and keeps its own variable names. This instance is the
# GEN-2 one: it must have its own database. Pointing it at gen-1's DSN or its port (127.0.0.1:8765
# on this host) is a deployment error — one gateway service per database.
# inside the container; published on 127.0.0.1:8771
RESEARCH_GATEWAY_LISTEN=0.0.0.0:8765
# sent to sources whose polite pool wants a contact address
RESEARCH_GATEWAY_CONTACT_EMAIL=you@example.org
# the gen-2 database, never gen-1's
RESEARCH_GATEWAY_DSN=postgresql://gateway@gateway-db:5432/gen2_research_loops
PGPASSWORD=example-database-password
# one bearer token per client; the gateway refuses to start without any
RESEARCH_GATEWAY_TOKENS=loops=example-token-issued-to-the-gen2-engine,mcp=example-token-for-mcp
RESEARCH_GATEWAY_WORKERS=2
# env only for now: the current image's vault mode is inadmissible (DEPLOYMENT-CONTRACT.md §3.4)
RESEARCH_GATEWAY_SECRETS=env
# 1 restores the serial lane loop
# RESEARCH_GATEWAY_LANE_CONCURRENCY=4
# aggregate lanes in flight across all requests
# RESEARCH_GATEWAY_LANE_TOTAL=16
# RESEARCH_GATEWAY_NTFY_URL=https://ntfy.example.org
# RESEARCH_GATEWAY_NTFY_TOPIC=gen2-research-gateway

# ================================================================================================
# Gateway secrets, vault backend
# ================================================================================================
# NOT ADMISSIBLE YET (DEPLOYMENT-CONTRACT.md §3.4). With RESEARCH_GATEWAY_VAULT_TOKEN_FILE unset,
# the current gateway image falls back to ~/.vault-token, which in a container resolves somewhere
# nobody chose; and it reports every failed read exactly like a missing key. Setting the token file
# avoids only the first. That is the 2026-09-21..24 outage. Leave these commented until a reviewed
# gateway release passes §3.4's tests; then the token file is REQUIRED, with its own path.
# RESEARCH_GATEWAY_VAULT_ADDR=https://vault.example.org:8200
# mounted read-only, 0400, its own path
# RESEARCH_GATEWAY_VAULT_TOKEN_FILE=/run/secrets/gateway-vault-token
# RESEARCH_GATEWAY_VAULT_MOUNT=secret
# RESEARCH_GATEWAY_VAULT_PREFIX=services
# logical=vault-name, when paths differ
# RESEARCH_GATEWAY_VAULT_ALIASES=api_data_gov=api-data-gov

# ================================================================================================
# Research source keys — GENERATED FROM THE REGISTRY
# ================================================================================================
# One variable per secret a source needs. Every entry below exists because a registry row says the
# source reads it; nothing is listed from memory and nothing a row needs is omitted. Optional
# credentials are emitted commented out: the source works without them, at its unauthenticated
# limits. Per-source acquisition instructions are in docs/gen2/SOURCE-CATALOG.md.
#
# A read that FAILS (403, unreachable vault, unreadable token file) is a dated
# `secrets backend failing` capability fact. A read that SUCCEEDS AND FINDS NOTHING is "no secret
# configured". The two are never collapsed, and neither ever becomes searched_empty or a zero.

# ---- Article indexes -----------------------------------------------------------------------------
# OpenAIRE Graph [openaire] field `client_id` — required. Create an account at
#   https://develop.openaire.eu, complete Personal Information, then Registered Services → + New
#   Service → Basic → Create. Store the Client ID and Client Secret; the gateway exchanges them
#   for hourly bearer tokens (POST https://aai.openaire.eu/oidc/token,
#   grant_type=client_credentials).
RESEARCH_GATEWAY_SECRET_OPENAIRE_CLIENT_ID=example-openaire-client-id
# OpenAIRE Graph [openaire] field `client_secret` — required. Create an account at
#   https://develop.openaire.eu, complete Personal Information, then Registered Services → + New
#   Service → Basic → Create. Store the Client ID and Client Secret; the gateway exchanges them
#   for hourly bearer tokens (POST https://aai.openaire.eu/oidc/token,
#   grant_type=client_credentials).
RESEARCH_GATEWAY_SECRET_OPENAIRE_CLIENT_SECRET=example-openaire-client-secret
# Semantic Scholar [semanticscholar] — required. Request a free API key at
#   https://www.semanticscholar.org/product/api (form; key arrives by email). Send it as the
#   x-api-key header.
RESEARCH_GATEWAY_SECRET_SEMANTIC_SCHOLAR=example-semantic-scholar-key

# ---- Dataset and repository indexes --------------------------------------------------------------
# GovInfo (U.S. Government Publishing Office) [govinfo] — required. Get a free key at
#   https://api.data.gov/signup/ (one key works across api.data.gov-hosted APIs). Send it as the
#   X-Api-Key header.
RESEARCH_GATEWAY_SECRET_API_DATA_GOV=example-api-data-gov-key
# Harvard Dataverse [harvard_dataverse] — OPTIONAL (higher limits). No key needed for public
#   data. An optional API token (account menu → API Token) raises limits and reaches restricted
#   files.
# RESEARCH_GATEWAY_SECRET_HARVARD_DATAVERSE=example-harvard-dataverse-key
# Socrata Open Data Network (SODA) [socrata] — OPTIONAL (higher limits). Optional app token:
#   create an account on any Socrata-hosted portal (e.g. data.cityofchicago.org), Developer
#   Settings → Create New App Token. Anonymous access is throttled.
# RESEARCH_GATEWAY_SECRET_SOCRATA=example-socrata-key
# Kaggle datasets [kaggle] field `username` — required. Create an account, then
#   https://www.kaggle.com/settings → API → Create New Token. Store the username and the token;
#   the gateway uses HTTP basic auth.
RESEARCH_GATEWAY_SECRET_KAGGLE_USERNAME=example-kaggle-username
# Kaggle datasets [kaggle] field `key` — required. Create an account, then
#   https://www.kaggle.com/settings → API → Create New Token. Store the username and the token;
#   the gateway uses HTTP basic auth.
RESEARCH_GATEWAY_SECRET_KAGGLE_KEY=example-kaggle-key
# Hugging Face Hub [huggingface] — OPTIONAL (higher limits). Optional token: account → Settings
#   → Access Tokens (read scope). Raises rate limits and reaches gated repositories.
# RESEARCH_GATEWAY_SECRET_HUGGINGFACE=example-huggingface-key
# Qualitative Data Repository (QDR) [qdr] — required. Register at
#   https://qdr.syr.edu/user/register, then on data.qdr.syr.edu open your account menu → API
#   Token → Create Token. Sent as the X-Dataverse-key header. Catalog search works without a
#   token.
RESEARCH_GATEWAY_SECRET_QDR=example-qdr-key

# ---- Resolvers and enrichment --------------------------------------------------------------------
# CORE [core] — required. Register at https://core.ac.uk/services/api for a free key (personal /
#   unfunded public research only). Sent as a Bearer token.
RESEARCH_GATEWAY_SECRET_CORE=example-core-key

# ---- Statistical data APIs -----------------------------------------------------------------------
# FRED (Federal Reserve Economic Data) [fred] — required. Create a free account, then
#   https://fred.stlouisfed.org/docs/api/api_key.html → Request API Key. Sent as the api_key
#   query parameter.
RESEARCH_GATEWAY_SECRET_FRED=example-fred-key
# U.S. Bureau of Economic Analysis (BEA) Data API [bea] — required. Sign up at
#   https://apps.bea.gov/api/signup/ (name + email). The key arrives by email and must be
#   activated via the link in that email before it works. Sent as the UserID query parameter.
RESEARCH_GATEWAY_SECRET_BEA=example-bea-key
# U.S. Census Bureau Data API [census] — required. Request at
#   https://api.census.gov/data/key_signup.html; the key arrives by email and must be activated
#   via the link in that email. Sent as the key query parameter.
RESEARCH_GATEWAY_SECRET_CENSUS=example-census-key
# U.S. Bureau of Labor Statistics API [bls] — OPTIONAL (higher limits). Optional free
#   registration key at https://data.bls.gov/registrationEngine/ raises the daily query limit.
#   Sent in the request body as registrationkey.
# RESEARCH_GATEWAY_SECRET_BLS=example-bls-key
