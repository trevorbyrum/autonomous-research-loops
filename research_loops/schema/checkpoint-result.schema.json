{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "inventory_version": {
      "type": "string",
      "minLength": 1
    },
    "trigger_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "complete": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocol_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "proposal_version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "addition",
              "amendment",
              "scope_request"
            ]
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "inference": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "locator",
                "observation",
                "inference"
              ]
            },
            "minItems": 1
          },
          "evidence_target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "route": {
                "type": "string",
                "minLength": 1
              },
              "support": {
                "type": "string",
                "minLength": 1
              },
              "complication": {
                "type": "string",
                "minLength": 1
              },
              "null": {
                "type": "string",
                "minLength": 1
              },
              "unresolved": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "route",
              "support",
              "complication",
              "null",
              "unresolved"
            ]
          },
          "nearest_reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "non_duplication": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reference",
              "non_duplication"
            ]
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "counterargument": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "content": {
            "type": "object"
          }
        },
        "required": [
          "proposal_id",
          "proposal_version",
          "kind",
          "anchors",
          "evidence_target",
          "nearest_reference",
          "consequence",
          "counterargument",
          "dependencies",
          "content"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "addition"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "text",
                    "source_ref"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "amendment"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "target_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "current_text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "proposed_text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "framing_defect": {
                      "type": "string",
                      "minLength": 1
                    },
                    "implications": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "target_id",
                    "current_text",
                    "proposed_text",
                    "framing_defect",
                    "implications"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scope_request"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requested_mission": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "requested_mission",
                    "rationale"
                  ]
                }
              }
            }
          }
        ]
      },
      "maxItems": 2
    },
    "reuse_of": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "episode_id",
    "run_id",
    "inventory_version",
    "trigger_ids",
    "complete",
    "findings",
    "limitations",
    "protocol_evidence_refs",
    "proposals"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate checkpoint result",
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          },
          "proposals": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reuse_of"
        ]
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "proposals": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "examples": [
    {
      "episode_id": "checkpoint-example",
      "run_id": "lease-example",
      "inventory_version": "approved-lock",
      "trigger_ids": [
        "cadence-25"
      ],
      "complete": true,
      "findings": [
        "Reviewed approved inventory and evidence."
      ],
      "limitations": [],
      "protocol_evidence_refs": [
        ".checkpoint-reports/counter.txt"
      ],
      "proposals": []
    }
  ]
}
