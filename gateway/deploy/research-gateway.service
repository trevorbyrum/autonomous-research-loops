# systemd unit for a Linux host running the gateway from a checkout (user or system scope).
#   cp deploy/research-gateway.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now research-gateway
# Needs a virtual environment with psycopg: python3 -m venv ~/.venvs/research-gateway && ~/.venvs/research-gateway/bin/pip install 'psycopg[binary]'
# WorkingDirectory is the gateway/ directory of your checkout; EnvironmentFile holds RESEARCH_GATEWAY_DSN,
# RESEARCH_GATEWAY_TOKENS and the secrets settings and is not in the repository.
[Unit]
Description=Research gateway (metered, logged, licence-aware door to research sources)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/work/research-loops-public/gateway
EnvironmentFile=%h/.config/research-loops/gateway.env
ExecStart=%h/.venvs/research-gateway/bin/python3 -m research_gateway.api.http
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
