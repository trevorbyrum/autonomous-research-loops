# Copy to deploy/gateway.env (gitignored) and fill in. Example values only.
RESEARCH_GATEWAY_LISTEN=0.0.0.0:8765
RESEARCH_GATEWAY_CONTACT_EMAIL=you@example.org
RESEARCH_GATEWAY_DSN=postgresql://gateway@db-host:5432/research_loops
PGPASSWORD=example-database-password
RESEARCH_GATEWAY_TOKENS=loops=example-token-for-the-loops,mcp=example-token-for-the-mcp-gateway
RESEARCH_GATEWAY_WORKERS=2
# secrets: environment variables per source ...
RESEARCH_GATEWAY_SECRETS=env
RESEARCH_GATEWAY_SECRET_FRED=example-fred-key
# ... or a vault (settings only; the token file is mounted read-only)
# RESEARCH_GATEWAY_SECRETS=vault
# RESEARCH_GATEWAY_VAULT_ADDR=https://vault.example.org:8200
# RESEARCH_GATEWAY_VAULT_MOUNT=secret
# RESEARCH_GATEWAY_VAULT_PREFIX=services
# RESEARCH_GATEWAY_VAULT_TOKEN_FILE=/run/vault-token
# RESEARCH_GATEWAY_VAULT_ALIASES=api_data_gov=api-data-gov
# alerts (optional)
# RESEARCH_GATEWAY_NTFY_URL=https://ntfy.example.org
# RESEARCH_GATEWAY_NTFY_TOPIC=research-gateway
